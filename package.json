{
  "name": "lift-and-coast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "diagnose:ai": "AI_TELEMETRY=1 vitest run tests/aiTelemetry.test.ts",
    "diagnose:line": "LINE_BENCHMARK=1 vitest run tests/racingLineQuality.test.ts",
    "diagnose:ace": "ACE_BENCHMARK=1 vitest run --pool=threads --maxWorkers=1 tests/aceTrackBenchmark.test.ts",
    "diagnose:ace-field": "ACE_FIELD_BENCHMARK=1 vitest run --pool=threads --maxWorkers=1 tests/aceFieldBenchmark.test.ts",
    "build:track": "node --experimental-strip-types scripts/build-track.mts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "next": "16.3.4",
    "peerjs": "^1.5.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
